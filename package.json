{
  "name": "orch-electron",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "release": "electron-builder --publish always",
    "release:dry": "electron-builder --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.108.2",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.20.0",
    "pg": "^8.22.0",
    "play-dl": "^1.9.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "node-pty": "^1.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.orch.electron",
    "productName": "ORCH",
    "copyright": "Copyright © 2026 redCRAFT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/",
        "to": "build/",
        "filter": ["**/*", "!installer.nsh"]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "reedonee",
      "repo": "ORCH"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORCH",
      "installerIcon": "ORCH LOGO1.ico",
      "uninstallerIcon": "ORCH LOGO1.ico",
      "installerHeaderIcon": "ORCH LOGO1.ico",
      "installerHeader": "build/installer-header.bmp",
      "include": "build/installer.nsh",
      "perMachine": false,
      "unicode": true
    },
    "win": {
      "target": "nsis",
      "icon": "ORCH LOGO1.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
